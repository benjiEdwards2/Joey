# Secrets — live values exist only in deploy/.env on the box (template: deploy/.env.example)
.env
*.env
!*.env.example
# NAS one-shot backups of .env / edge.env (nas_scripts/*.sh) can carry secrets
*.bak-*

# SQLite — lives on the box SSD, never in git
*.db
*.db-wal
*.db-shm

# Runtime data lives outside the repo (NAS: /volume1/Docker/joey/data — D10 remap).
# Root-anchored: an unanchored data/ silently swallowed connectors/schema/data/
# (found at the 2026-08-31 NAS bring-up).
/data/

# Money plaintext NEVER reaches git (pulled forward from WP37 — sequencing rule 6)
connectors/money/samples/
connectors/money/golden_local/
connectors/money/**/*.csv
drop/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# NAS-side deploy log (deploy.sh appends; never committed)
/deploy/history.log
# one log per deploy.sh run (detached deploys, 2026-10-20)
/deploy/logs/

# Local eyes-on previews (scripts/render_film_preview.py) — generated, never committed
/.preview/

# Joey TV shell (tv/, WP-B7): signing material and Gradle output never reach git.
# The ONE exception is the clearly labelled public debug key (tv/app/debug-signing/README.md).
*.jks
*.keystore
*.p12
keystore.properties
!/tv/app/debug-signing/joeytv-debug.p12
/tv/**/build/
/tv/.gradle/
/tv/.kotlin/
/tv/local.properties
