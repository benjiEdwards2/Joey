BEGIN:VCALENDAR
METHOD:PUBLISH
PRODID:Microsoft Exchange Server 2010
VERSION:2.0
X-WR-CALNAME:Sample Partner (fixture)
BEGIN:VTIMEZONE
TZID:Australia/Perth
BEGIN:STANDARD
DTSTART:16010101T000000
TZOFFSETFROM:+0800
TZOFFSETTO:+0800
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
DESCRIPTION:Outlook-generated recurrence: UNTIL is in UTC while DTSTART car
 ries a TZID\, and the line is folded at 75 octets the way Exchange emits it.
RRULE:FREQ=WEEKLY;UNTIL=20260331T020000Z;INTERVAL=1;BYDAY=WE;WKST=SU
UID:fixture-outlook-weekly@example.invalid
SUMMARY:Pilates class
DTSTART;TZID=Australia/Perth:20260107T180000
DTEND;TZID=Australia/Perth:20260107T190000
CLASS:PUBLIC
PRIORITY:5
DTSTAMP:20251201T000000Z
TRANSP:OPAQUE
STATUS:CONFIRMED
SEQUENCE:0
LOCATION:Studio (fixture)
X-MICROSOFT-CDO-APPT-SEQUENCE:0
X-MICROSOFT-CDO-BUSYSTATUS:BUSY
X-MICROSOFT-CDO-INTENDEDSTATUS:BUSY
X-MICROSOFT-CDO-ALLDAYEVENT:FALSE
X-MICROSOFT-CDO-IMPORTANCE:1
X-MICROSOFT-CDO-INSTTYPE:1
END:VEVENT
BEGIN:VEVENT
DESCRIPTION:Outlook all-day quirk: emitted as VALUE=DATE with the CDO all-day
  flag set\, DTEND exclusive.
UID:fixture-outlook-allday@example.invalid
SUMMARY:Public holiday
DTSTART;VALUE=DATE:20260126
DTEND;VALUE=DATE:20260127
CLASS:PUBLIC
PRIORITY:5
DTSTAMP:20251201T000000Z
TRANSP:TRANSPARENT
STATUS:CONFIRMED
SEQUENCE:0
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-ALLDAYEVENT:TRUE
X-MICROSOFT-CDO-INSTTYPE:0
END:VEVENT
BEGIN:VEVENT
DESCRIPTION:Timezone-offset case: written in UTC by Exchange.
UID:fixture-outlook-utc@example.invalid
SUMMARY:Dentist
DTSTART:20260106T003000Z
DTEND:20260106T011500Z
CLASS:PUBLIC
PRIORITY:5
DTSTAMP:20251201T000000Z
TRANSP:OPAQUE
STATUS:CONFIRMED
SEQUENCE:0
X-MICROSOFT-CDO-BUSYSTATUS:BUSY
X-MICROSOFT-CDO-INSTTYPE:0
