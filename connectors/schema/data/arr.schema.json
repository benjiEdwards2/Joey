{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benjiEdwards2/life-dashboard/connectors/schema/data/arr.schema.json",
  "title": "arr data block",
  "description": "Media area library feed (Radarr + Sonarr). One app being down is DATA (`app_errors`), not a failed run. Optional `radarr`/`sonarr`/`prowlarr` count objects (WP-S3) are partial-ok: null on failure. Lists are capped at 20. `summary`/`secondary` are the hub display convention (D17, WP18).",
  "type": "object",
  "required": ["summary", "secondary", "arrived", "updated", "this_week", "downloading", "disk"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "secondary": {"type": "string"},
    "arrived": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "kind", "when"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "kind": {"enum": ["movie", "season", "episode"]},
          "when": {"type": "string"},
          "at": {"type": "string"}
        }
      }
    },
    "updated": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "kind", "when", "what"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "kind": {"enum": ["movie", "season", "episode"]},
          "when": {"type": "string"},
          "at": {"type": "string"},
          "what": {"type": "string"}
        }
      }
    },
    "this_week": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "kind", "date", "label"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "kind": {"enum": ["movie", "season", "episode"]},
          "date": {"type": "string", "format": "date"},
          "label": {"enum": ["Premiere", "Finale", "Digital", "Disc", "Cinemas", ""]}
        }
      }
    },
    "downloading": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "kind", "pct", "status_text", "time_left"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "kind": {"enum": ["movie", "season", "episode"]},
          "pct": {"type": "integer", "minimum": 0, "maximum": 100},
          "status_text": {"type": "string"},
          "time_left": {"type": "string"},
          "download_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]+$"}
        }
      }
    },
    "disk": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["path", "free_gb", "total_gb", "pct_used"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "free_gb": {"type": "number", "minimum": 0},
          "total_gb": {"type": "number", "minimum": 0},
          "pct_used": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    },
    "radarr": {
      "description": "Library counts (WP-S3, 2026-10-06). null when the count call failed or Radarr is down; absent in older envelopes.",
      "type": ["object", "null"],
      "required": ["movies", "wanted", "missing", "queued"],
      "additionalProperties": false,
      "properties": {"movies": {"type": "integer", "minimum": 0}, "wanted": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0}, "queued": {"type": "integer", "minimum": 0}}
    },
    "sonarr": {
      "description": "Library counts (WP-S3, 2026-10-06). null when a count call failed or Sonarr is down; absent in older envelopes.",
      "type": ["object", "null"],
      "required": ["series", "wanted", "queued"],
      "additionalProperties": false,
      "properties": {"series": {"type": "integer", "minimum": 0}, "wanted": {"type": "integer", "minimum": 0}, "queued": {"type": "integer", "minimum": 0}}
    },
    "prowlarr": {
      "description": "Indexer stats summed across indexers (WP-S3, 2026-10-06). null when PROWLARR_URL/PROWLARR_API_KEY are unset or the call failed; absent in older envelopes.",
      "type": ["object", "null"],
      "required": ["grabs", "queries", "failed_grabs", "failed_queries", "indexers"],
      "additionalProperties": false,
      "properties": {"grabs": {"type": "integer", "minimum": 0}, "queries": {"type": "integer", "minimum": 0}, "failed_grabs": {"type": "integer", "minimum": 0}, "failed_queries": {"type": "integer", "minimum": 0}, "indexers": {"type": "integer", "minimum": 0}}
    },
    "app_errors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radarr": {"type": "string"},
        "sonarr": {"type": "string"}
      }
    }
  }
}
