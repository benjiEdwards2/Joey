{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benjiEdwards2/life-dashboard/connectors/schema/data/arr.schema.json",
  "title": "arr data block",
  "description": "Media area library feed (Radarr + Sonarr). One app being down is DATA (`app_errors`), not a failed run. Optional `radarr`/`sonarr`/`prowlarr` count objects (WP-S3) are partial-ok: null on failure. Lists are capped at 20. `summary`/`secondary` are the hub display convention (D17, WP18).",
  "type": "object",
  "required": ["summary", "secondary", "arrived", "updated", "this_week", "downloading", "disk"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "secondary": {"type": "string"},
    "partial_errors": {
      "type": "object",
      "description": "C-10 (2026-10-09), the one partial-failure convention: present only when the feed is ok but some of its sources failed this sweep; source -> sanitized reason (type/status only, never a URL). Additive: older per-feed keys stay.",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "arrived": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "kind", "when"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "kind": {"enum": ["movie", "season", "episode"]},
          "when": {"type": "string"},
          "at": {"type": "string"}
        }
      }
    },
    "updated": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "kind", "when", "what"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "kind": {"enum": ["movie", "season", "episode"]},
          "when": {"type": "string"},
          "at": {"type": "string"},
          "what": {"type": "string"}
        }
      }
    },
    "this_week": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "kind", "date", "label"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "kind": {"enum": ["movie", "season", "episode"]},
          "date": {"type": "string", "format": "date"},
          "label": {"enum": ["Premiere", "Finale", "Digital", "Disc", "Cinemas", ""]}
        }
      }
    },
    "downloading": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "kind", "pct", "status_text", "time_left"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "kind": {"enum": ["movie", "season", "episode"]},
          "pct": {"type": "integer", "minimum": 0, "maximum": 100},
          "status_text": {"type": "string"},
          "time_left": {"type": "string"},
          "download_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]+$"}
        }
      }
    },
    "disk": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["path", "free_gb", "total_gb", "pct_used"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "free_gb": {"type": "number", "minimum": 0},
          "total_gb": {"type": "number", "minimum": 0},
          "pct_used": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    },
    "radarr": {
      "description": "Library counts (WP-S3, 2026-10-06). null when the count call failed or Radarr is down; absent in older envelopes.",
      "type": ["object", "null"],
      "required": ["movies", "wanted", "missing", "queued"],
      "additionalProperties": false,
      "properties": {"movies": {"type": "integer", "minimum": 0}, "wanted": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0}, "queued": {"type": "integer", "minimum": 0}, "upgrades": {"type": "integer", "minimum": 0, "description": "F4a (2026-10-12): cutoff-unmet movies (totalRecords); absent when that call failed or in older envelopes."}}
    },
    "sonarr": {
      "description": "Library counts (WP-S3, 2026-10-06). null when a count call failed or Sonarr is down; absent in older envelopes.",
      "type": ["object", "null"],
      "required": ["series", "wanted", "queued"],
      "additionalProperties": false,
      "properties": {"series": {"type": "integer", "minimum": 0}, "wanted": {"type": "integer", "minimum": 0}, "queued": {"type": "integer", "minimum": 0}, "upgrades": {"type": "integer", "minimum": 0, "description": "F4a (2026-10-12): cutoff-unmet episodes (totalRecords); absent when that call failed or in older envelopes."}}
    },
    "prowlarr": {
      "description": "Indexer stats summed across indexers (WP-S3, 2026-10-06). null when PROWLARR_URL/PROWLARR_API_KEY are unset or the call failed; absent in older envelopes.",
      "type": ["object", "null"],
      "required": ["grabs", "queries", "failed_grabs", "failed_queries", "indexers"],
      "additionalProperties": false,
      "properties": {"grabs": {"type": "integer", "minimum": 0}, "queries": {"type": "integer", "minimum": 0}, "failed_grabs": {"type": "integer", "minimum": 0}, "failed_queries": {"type": "integer", "minimum": 0}, "indexers": {"type": "integer", "minimum": 0}}
    },
    "upgrades": {
      "description": "F4a (2026-10-12): titles whose file on disk is below their quality profile's cutoff (Radarr/Sonarr 'cutoff unmet', GET /api/v3/wanted/cutoff, one page of 100 sorted by title). It does NOT mean a better release is on the indexers right now. An app's list is null when the app is down or its cutoff call failed (partial_errors '<app>_upgrades'). `want` is the profile cutoff's name, null when the profile list is unavailable. Absent in older envelopes.",
      "type": "object",
      "required": ["radarr", "sonarr", "totals"],
      "additionalProperties": false,
      "properties": {
        "radarr": {
          "type": ["array", "null"],
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["item_key", "title", "year", "arr_id", "have", "want", "poster"],
            "additionalProperties": false,
            "properties": {
              "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "title": {"type": "string"},
              "year": {"type": ["integer", "null"]},
              "arr_id": {"type": ["integer", "null"]},
              "have": {"type": ["string", "null"]},
              "want": {"type": ["string", "null"]},
              "profile": {"type": ["string", "null"], "description": "WP-U1 (2026-10-21): the quality profile's own name; absent in older envelopes."},
              "poster": {"type": ["string", "null"]}
            }
          }
        },
        "sonarr": {
          "type": ["array", "null"],
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["item_key", "title", "arr_id", "episodes", "have", "want", "sample", "poster"],
            "additionalProperties": false,
            "properties": {
              "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "title": {"type": "string"},
              "arr_id": {"type": ["integer", "null"]},
              "episodes": {"type": "integer", "minimum": 1},
              "have": {"type": ["string", "null"]},
              "want": {"type": ["string", "null"]},
              "profile": {"type": ["string", "null"], "description": "WP-U1 (2026-10-21): the quality profile's own name; absent in older envelopes."},
              "sample": {"type": ["string", "null"], "pattern": "^S[0-9]{2}(E[0-9]{2,})?$"},
              "episode_id": {"type": ["integer", "null"], "description": "WP-U1 (2026-10-21): the Sonarr episode id of `sample` (the hub's Why? searches it); absent in older envelopes."},
              "poster": {"type": ["string", "null"]}
            }
          }
        },
        "last_search": {
          "description": "WP-U1 (2026-10-21): per app (Radarr first), the newest whole-library upgrade / missing search on GET /api/v3/command; an app without one, or whose command call failed, is left out. Absent in older envelopes.",
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "app", "status", "ended", "message"],
            "additionalProperties": false,
            "properties": {
              "name": {"enum": ["upgrades", "missing"]},
              "app": {"enum": ["radarr", "sonarr"]},
              "status": {"type": "string"},
              "ended": {"type": ["string", "null"]},
              "message": {"type": ["string", "null"], "maxLength": 200}
            }
          }
        },
        "totals": {
          "description": "movies / episodes = the cutoff calls' totalRecords (may exceed the listed page); series = Sonarr rows listed. 0 for an app whose list is null.",
          "type": "object",
          "required": ["movies", "episodes", "series"],
          "additionalProperties": false,
          "properties": {"movies": {"type": "integer", "minimum": 0}, "episodes": {"type": "integer", "minimum": 0}, "series": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "library_sizes": {
      "description": "P1a (2026-10-22): per-title size on disk for the hub's Free space page, biggest first, from the library lists the counts already fetch (no extra call). An app whose list was not fetched is null. Absent in older envelopes.",
      "type": "object",
      "required": ["radarr", "sonarr"],
      "additionalProperties": false,
      "properties": {
        "radarr": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["tmdb_id", "title", "year", "size_bytes"],
            "additionalProperties": false,
            "properties": {
              "tmdb_id": {"type": ["integer", "null"]},
              "title": {"type": "string"},
              "year": {"type": ["integer", "null"]},
              "size_bytes": {"type": "integer", "minimum": 1}
            }
          }
        },
        "sonarr": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["tvdb_id", "tmdb_id", "title", "size_bytes", "ended"],
            "additionalProperties": false,
            "properties": {
              "tvdb_id": {"type": ["integer", "null"]},
              "tmdb_id": {"type": ["integer", "null"]},
              "title": {"type": "string"},
              "size_bytes": {"type": "integer", "minimum": 1},
              "ended": {"type": "boolean"}
            }
          }
        }
      }
    },
    "app_errors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radarr": {"type": "string"},
        "sonarr": {"type": "string"}
      }
    }
  }
}
