{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benjiEdwards2/life-dashboard/connectors/schema/data/jellyfin.schema.json",
  "title": "jellyfin data block",
  "description": "Media area tile. `summary`/`secondary` are the hub display convention (D17, WP18).",
  "type": "object",
  "required": ["summary", "now_playing", "up_next", "latest", "library"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "secondary": {"type": "string"},
    "now_playing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "user", "progress_pct", "play_method"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "user": {"type": "string"},
          "progress_pct": {"type": "integer", "minimum": 0, "maximum": 100},
          "play_method": {"enum": ["Direct play", "Direct stream", "Transcoding"]}
        }
      }
    },
    "up_next": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "kind", "remaining_text"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "kind": {"enum": ["movie", "episode"]},
          "remaining_text": {"type": "string"}
        }
      }
    },
    "latest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "added_at", "type"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "added_at": {"type": "string"},
          "type": {"type": "string"}
        }
      }
    },
    "library": {
      "type": "object",
      "required": ["movies", "episodes"],
      "additionalProperties": false,
      "properties": {
        "movies": {"type": "integer", "minimum": 0},
        "episodes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
