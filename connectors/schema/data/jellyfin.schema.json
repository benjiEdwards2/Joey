{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benjiEdwards2/life-dashboard/connectors/schema/data/jellyfin.schema.json",
  "title": "jellyfin data block",
  "description": "Media area tiles (now playing + watch history). `summary`/`secondary` are the hub display convention (D17, WP18). `history` is optional so snapshots written before it existed still validate. `movies`/`shows` (F3a) are the whole-library lists, optional like `history`.",
  "type": "object",
  "required": ["summary", "now_playing", "up_next", "latest", "library"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "secondary": {"type": "string"},
    "partial_errors": {
      "type": "object",
      "description": "C-10 (2026-10-09), the one partial-failure convention: present only when the feed is ok but some of its sources failed this sweep; source -> sanitized reason (type/status only, never a URL). Additive: older per-feed keys stay.",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "server_id": {"type": ["string", "null"]},
    "library_fetched_at": {"type": "string", "description": "Live only (C-18, 2026-10-09): when `movies`/`shows` were last fetched; between fetches they are reused from the previous envelope for JELLYFIN_LIBRARY_EVERY_S (default 900 s)."},
    "now_playing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "user", "progress_pct", "play_method"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "jf_id": {"type": ["string", "null"]},
          "show_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "season_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "episode_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "season": {"type": ["integer", "null"]},
          "episode": {"type": ["integer", "null"]},
          "show_title": {"type": ["string", "null"]},
          "backdrop": {"type": ["string", "null"]},
          "user": {"type": "string"},
          "progress_pct": {"type": "integer", "minimum": 0, "maximum": 100},
          "play_method": {"enum": ["Direct play", "Direct stream", "Transcoding"]}
        }
      }
    },
    "up_next": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "kind", "remaining_text"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "jf_id": {"type": ["string", "null"]},
          "show_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "season_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "episode_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "season": {"type": ["integer", "null"]},
          "episode": {"type": ["integer", "null"]},
          "show_title": {"type": ["string", "null"]},
          "backdrop": {"type": ["string", "null"]},
          "kind": {"enum": ["movie", "episode"]},
          "remaining_text": {"type": "string"}
        }
      }
    },
    "latest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "added_at", "type"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "poster": {"type": ["string", "null"]},
          "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
          "jf_id": {"type": ["string", "null"]},
          "added_at": {"type": "string"},
          "type": {"type": "string"}
        }
      }
    },
    "library": {
      "type": "object",
      "required": ["movies", "episodes"],
      "additionalProperties": false,
      "properties": {
        "movies": {"type": "integer", "minimum": 0},
        "episodes": {"type": "integer", "minimum": 0}
      }
    },
    "history": {
      "type": "object",
      "required": ["recent", "week_count", "month_count", "hours_total", "hours_month",
                   "most_played_shows", "most_played_movies", "on_this_day"],
      "additionalProperties": false,
      "properties": {
        "recent": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["title", "kind", "watched_at", "when"],
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "poster": {"type": ["string", "null"]},
              "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "jf_id": {"type": ["string", "null"]},
              "show_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "season_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "episode_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "season": {"type": ["integer", "null"]},
              "episode": {"type": ["integer", "null"]},
              "show_title": {"type": ["string", "null"]},
              "kind": {"enum": ["movie", "episode"]},
              "watched_at": {"type": "string"},
              "when": {"type": "string"}
            }
          }
        },
        "week_count": {"type": "integer", "minimum": 0},
        "month_count": {"type": "integer", "minimum": 0},
        "hours_total": {"type": "number", "minimum": 0},
        "hours_month": {"type": "number", "minimum": 0},
        "most_played_shows": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["title", "episodes", "hours"],
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "poster": {"type": ["string", "null"]},
              "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "episodes": {"type": "integer", "minimum": 0},
              "hours": {"type": "number", "minimum": 0}
            }
          }
        },
        "most_played_movies": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["title", "plays"],
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "poster": {"type": ["string", "null"]},
              "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "plays": {"type": "integer", "minimum": 1}
            }
          }
        },
        "on_this_day": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["title", "kind", "years_ago"],
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "poster": {"type": ["string", "null"]},
              "item_key": {"type": ["string", "null"], "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"},
              "jf_id": {"type": ["string", "null"]},
              "kind": {"enum": ["movie", "episode"]},
              "years_ago": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "movies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "year",
          "jf_id",
          "item_key",
          "poster",
          "backdrop",
          "played",
          "last_played_at",
          "added_at",
          "community_rating",
          "genres",
          "runtime_min"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "jf_id": {
            "type": "string"
          },
          "item_key": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"
          },
          "poster": {
            "type": [
              "string",
              "null"
            ]
          },
          "backdrop": {
            "type": [
              "string",
              "null"
            ]
          },
          "played": {
            "type": "boolean"
          },
          "last_played_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "added_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "community_rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "genres": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          },
          "runtime_min": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "shows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "year",
          "jf_id",
          "item_key",
          "poster",
          "backdrop",
          "played",
          "last_played_at",
          "added_at",
          "community_rating",
          "genres",
          "status_word",
          "episodes",
          "unplayed"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "jf_id": {
            "type": "string"
          },
          "item_key": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(tmdb|tvdb|jf):[A-Za-z0-9-]+$"
          },
          "poster": {
            "type": [
              "string",
              "null"
            ]
          },
          "backdrop": {
            "type": [
              "string",
              "null"
            ]
          },
          "played": {
            "type": "boolean"
          },
          "last_played_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "added_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "community_rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "genres": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          },
          "status_word": {
            "enum": [
              "Continuing",
              "Ended",
              "Unknown"
            ]
          },
          "episodes": {
            "type": "integer",
            "minimum": 0
          },
          "unplayed": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "her": {
      "description": "Georgina's up next + history (2026-10-05); null when JELLYFIN_USER_HER is unset or no such user. Same row shapes as the top-level fields.",
      "type": ["object", "null"],
      "required": ["user", "up_next", "history"],
      "additionalProperties": false,
      "properties": {
        "user": {"type": "string"},
        "up_next": {"$ref": "#/properties/up_next"},
        "history": {"$ref": "#/properties/history"},
        "movies": {"$ref": "#/properties/movies"},
        "shows": {"$ref": "#/properties/shows"}
      }
    }
  }
}
