# Template for deploy/.env — the real file lives ONLY on the NAS
# (/volume1/Docker/joey/life-dashboard/deploy/.env) and is git-ignored.
# Fill values there; never commit, log, or paste them anywhere.
#
# Recommended split (least privilege, review D-05): compose ALSO reads two optional files,
# deploy/hub.env (hub only) and deploy/connectors.env (connectors only); a key in them overrides
# the same key in .env. Until they exist this one .env still feeds both services. To split, move:
#   hub.env        - OWNER_*, OMDB_API_KEY, SERVER_DISCORD_WEBHOOK, MEDIA_FOLLOW, STACKCTL_*,
#                    MEDIA_DISCORD_WEBHOOK, AWARDS_CONTACT, MEDIA_AWARDS
#   connectors.env - ICS_URL_*, MEDIA_STATUS_HOST, WUD_*, PROWLARR_*, UPTIME_KUMA_*
#   both files     - TZ, WEATHER_LAT/LON, JELLYFIN_*, RADARR_*, SONARR_*, JELLYSEERR_*, QBIT_* (hub: Quiet mode, P4)
#   .env           - TUNNEL_TOKEN only (compose interpolation for cloudflared). Once .env holds
#                    nothing else, drop `- .env` from the hub/connectors env_file lists so no
#                    app container carries the tunnel token. chmod 600 every one of these files.

# Timezone for containers (also the Open-Meteo forecast timezone)
TZ=Australia/Melbourne

# Cloudflare tunnel token — pasted by B. directly on the NAS, never
# via chat. Routes the domain to any origin: a leak requires rotation.
TUNNEL_TOKEN=

# Public edge (Joey TV WP-A3, 2026-10-18) - compose profiles. COMPOSE_PROFILES is read by compose from THIS file:
# `edge` starts joey-swag (host 443 -> 127.0.0.1:8096; WAN side is router 8443 -> NAS 443), `ddns` starts joey-ddns (never while the WAN IP is static, Q3).
# Unset = both stay dark. B. sets it on the NAS at WP-A4; never take `edge` out again without the kill-switch
# runbook R3 (docs/public-edge.md): a deploy with the profile off may remove joey-swag mid-stream (Q47).
# COMPOSE_PROFILES=edge
# Guest front (Joey TV WP-B1, 2026-10-21): `media` starts joey-media (JOEY_FRONT=media, media.joeyhome.net via the
# tunnel). It reads deploy/media.env ONLY (template deploy/media.env.example, built by nas_scripts/media_env.sh) - never
# this file. B. adds it at WP-B5 step 1 (COMPOSE_PROFILES=edge,media); never take it out without the kill-switch runbook.
#
# The Cloudflare token does NOT go in this file. It lives in deploy/edge.env (NAS-only, chmod 600, git- and
# docker-ignored), which only swag and ddns read (Q6); nas_scripts/append_env.sh takes it as its target argument and
# nas_scripts/edge_cf_ini.sh copies the token into SWAG's dns-conf/cloudflare.ini. Keys in deploy/edge.env:
# CLOUDFLARE_API_TOKEN=
# STAGING=true    (first certificate only, added by edge_cf_ini.sh --staging; removed for the production certificate)

# Signed-in user (2026-10-06) — Cloudflare Access admits two people. OWNER_EMAIL_YOU is
# B.'s own Access login address (the placeholder below is NOT it); that address reads and
# writes as "you", any other admitted address as "her". The other person's email address is
# never recorded here or anywhere in the repo. Unset = not configured: signed-in visitors get the
# "both" view and no owner (one warning in the hub log) - set it before anyone rates or logs.
OWNER_EMAIL_YOU=you@example.com
# Display names in the top-bar user chip and the hub greeting (defaults Benji / Georgina).
OWNER_NAME_YOU=Benji
OWNER_NAME_HER=Georgina
# Access JWT verification (Joey TV WP-A6a, 2026-10-19; hub only - hub.env if it exists): the hub checks Cloudflare's
# signed Cf-Access-Jwt-Assertion before it believes the email header. ACCESS_AUD = the joeyhome.net Access app's
# "Application Audience (AUD) Tag" (Zero Trust, Access controls, Applications, the app, Additional settings tab; comma-separate several); required once the flag is set, or the hub will not start.
# ACCESS_JWT_VERIFY=1   (0/unset = off, audit = log only)
# ACCESS_AUD=
# ACCESS_TEAM=joeyhomeed

# Open-Meteo weather — no key, just home coordinates (approximate is fine)
WEATHER_LAT=
WEATHER_LON=
# WEATHER_PLACE=Newport VIC   # optional: the place name shown in the weather labels (hub); default Newport VIC

# Calendar — the secret ICS URLs ARE the credential: B.'s Google feed
# and Georgina's Outlook feed. Pasted by B. directly on the NAS, never via chat.
ICS_URL_YOU=
ICS_URL_HER=

# Media area (2026-10-05) — Jellyfin API key from Dashboard > API Keys;
# JELLYFIN_URL like http://192.168.68.59:8096; JELLYFIN_USER (optional) is the
# display name whose "up next" to show, default the first administrator.
# MEDIA_STATUS_HOST is the NAS host/IP only (no scheme, no port).
# Once Joey shares the media stack's Docker network (docs/network.md) the *_URL keys can use service
# names instead of the LAN IP, e.g. http://jellyfin:8096 — except JELLYSEERR_URL, which also builds
# browser links and must stay reachable from a phone.
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER=
# JELLYFIN_USER_HER (optional, 2026-10-05): the exact Jellyfin display name of the second
# user. Unset = her view shows a quiet word. No fallback to the admin account.
JELLYFIN_USER_HER=
MEDIA_STATUS_HOST=
# Server area `system` feed needs nothing here: SYSTEM_VOLUMES (statvfs targets, default the
# snapshots dir) and SYSTEM_VOLUME_LABELS (`path=label[,path=label]`, the name the UI shows) are
# set in docker-compose.yml (connectors service), not in .env — they are not secrets.

# The hub reads the same Jellyfin/Radarr/Sonarr URL + key pairs (below) for the
# /img poster proxy — no separate variables; TMDB art needs no key.

# Media area (2026-10-05) — Radarr/Sonarr LAN addresses, e.g.
# http://192.168.68.59:7878 and :8989; API keys from Settings > General in each app.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# Media area — Jellyseerr LAN address (the NAS IP, port 5055)
# and its API key from Settings > General. The hub also uses these for the diary's
# "Log a watch" title search (2026-10-05); no new keys.
JELLYSEERR_URL=
JELLYSEERR_API_KEY=

# Film page Metacritic pill (media-ux4, 2026-10-08) - optional free OMDb key (omdbapi.com, 1,000 calls/day).
# The hub asks OMDb by IMDb id at most once per title per 7 days and <= 800 calls a day. Unset = no pill.
OMDB_API_KEY=

# Media area - qBittorrent Web UI LAN address (the NAS IP, port 8080) and its Web UI
# login (Tools > Options > Web UI). Read only: the connector never changes a torrent.
# P4 (2026-10-22): the hub also reads these for Server › Downloads Quiet mode (it writes the global download cap only).
QBIT_URL=
QBIT_USER=
QBIT_PASS=
# Quiet mode's download cap in Mbps (hub; default 5 = 625000 B/s). Full speed = no cap.
QUIET_MBPS=5
# The NAS sleep window shown beside the Quiet mode row (hub; words only, nothing is scheduled).
NAS_SLEEP_WINDOW=22:00–07:00

# Server area (2026-10-06) - What's Up Docker LAN address (the NAS IP, port 3030)
# and its basic-auth login (the same user/password as the WUD web UI). Hourly loop only.
WUD_URL=
WUD_USER=
WUD_PASS=
# Server area (2026-10-12, hub only) - stackctl, the media-stack helper (stackctl/NAS_INSTALL.md): its LAN address
# (http://<NAS IP>:8810) and the shared Bearer token (64 hex chars; root-equivalent on the NAS - guard it).
# Unset = no "Restart + update media stack" button.
STACKCTL_URL=
STACKCTL_TOKEN=
# Prowlarr (optional) - LAN address (the NAS IP, port 9696) and API key from Settings > General.
# Unset = the arr feed's `prowlarr` stats are null; Radarr/Sonarr are unaffected.
PROWLARR_URL=
PROWLARR_API_KEY=

# Server area (2026-10-06) - Uptime Kuma 1.23 LAN address (the NAS IP, port 3001) and
# an API key (Settings > API Keys). /metrics uses HTTP Basic with an EMPTY username and the
# key as the password - only the key goes here. Hourly loop and the 120 s fast loop.
UPTIME_KUMA_URL=
UPTIME_KUMA_API_KEY=

# Server area (2026-10-06) - optional Discord webhook URL (Server Settings > Integrations >
# Webhooks; the one WUD already uses is fine). The URL IS the credential: pasted by B. on the NAS
# only. Set = the hub posts each NEW Server Attention item once ("Joey Server: ..."); unset = no push.
SERVER_DISCORD_WEBHOOK=

# Overnight digest (P2, 2026-10-22) - ONE Discord message a day to SERVER_DISCORD_WEBHOOK (arrivals, updates, disk,
# services, torrents), sent once the hub-local time reaches DIGEST_AT. DIGEST=off stops it; no webhook = no digest.
DIGEST_AT=07:30
DIGEST=on

# Media Follow (2026-10-07) - the hub requests NEW films of followed people / film series through
# Jellyseerr every 6 h (and right after a Follow). MEDIA_FOLLOW=off stops the loop. Each auto-add posts
# one Discord message to MEDIA_DISCORD_WEBHOOK if set, else to SERVER_DISCORD_WEBHOOK; neither = silent.
MEDIA_FOLLOW=on
MEDIA_DISCORD_WEBHOOK=

# Media Awards (2026-10-08) - the hub reads ceremony winners / nominees from Wikidata + Wikipedia (public, keyless)
# into media.db: 40 ceremonies every 6 h until the backfill is done, then weekly. AWARDS_CONTACT is the contact the
# Wikimedia User-Agent policy requires (B.'s email; NAS .env only). Unset = no calls. MEDIA_AWARDS=off stops the loop.
AWARDS_CONTACT=
MEDIA_AWARDS=on

# Optional knobs (defaults shown; set only to change them):
# MEDIA_BACKUP=on          # off = no nightly media.db gzip backup (hub)
# MEDIA_WARMUP=on          # off = no background cache warm-up; shelves = home-shelf pass only (hub)
# PLAY_RECORDER=on         # off = stop polling Jellyfin /Sessions into the play history (hub)
# PLAY_POLL_SECONDS=60     # play-recorder poll interval, minimum 1 (hub)
# META_CACHE_DIR=          # disk cache for Jellyseerr/ratings bodies; default <IMG_CACHE_DIR>/meta (hub)
# JELLYFIN_LIBRARY_EVERY_S=900  # Jellyfin library lists re-fetched at most this often; 0 = every sweep (connectors)
# MEDIA_STATUS_HOSTS=      # app=host[:port],... probe over the Docker network (e.g. qbittorrent=gluetun,wud=wud:3000);
#                          # card links still use MEDIA_STATUS_HOST (connectors; see docs/network.md)
# AREAS_PATH=              # area registry file; default config/areas.yaml in the image (hub)
# HUB_DEV=1                # local only: re-read templates on every render (hub)

# Parked connectors — area hidden; the names the code reads, for when one is switched on:
# SUPABASE_URL=            # macromates
# SUPABASE_KEY=            # macromates
# HA_URL=                  # home_assistant
# HA_TOKEN=                # home_assistant
# NAS_SHARES_ROOT=         # nas_stats
