# Template for deploy/.env — the real file lives ONLY on the NAS
# (/volume1/Docker/joey/life-dashboard/deploy/.env) and is git-ignored.
# Fill values there; never commit, log, or paste them anywhere.

# Timezone for containers (Q2 — confirm before WP24)
TZ=

# Cloudflare tunnel token (WP11) — pasted by B. directly on the NAS, never
# via chat. Routes the domain to any origin: a leak requires rotation.
TUNNEL_TOKEN=

# WP24 Open-Meteo — no key, just home coordinates (approximate is fine)
WEATHER_LAT=
WEATHER_LON=

# WP25 calendar — the secret ICS URLs ARE the credential: B.'s Google feed
# and Georgina's Outlook feed. Pasted by B. directly on the NAS, never via chat.
ICS_URL_YOU=
ICS_URL_HER=

# Media area (Phase 1, 2026-10-05) — Jellyfin API key from Dashboard > API Keys;
# JELLYFIN_URL like http://192.168.68.59:8096; JELLYFIN_USER (optional) is the
# display name whose "up next" to show, default the first administrator.
# MEDIA_STATUS_HOST is the NAS host/IP only (no scheme, no port).
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER=
MEDIA_STATUS_HOST=

# Media area (Phase 2, 2026-10-05) — Radarr/Sonarr LAN addresses, e.g.
# http://192.168.68.59:7878 and :8989; API keys from Settings > General in each app.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# Later connectors add their variables here:
# MACROMATES_SUPABASE_URL=       (WP27)
# MACROMATES_SERVICE_KEY=        (WP27, pending Q17 sign-off)
# HOME_ASSISTANT_URL=            (WP28)
# HOME_ASSISTANT_TOKEN=          (WP28)
# NAS_STATS_ROOT=                (WP30)
