# Template for deploy/.env — the real file lives ONLY on the NAS
# (/volume1/Docker/joey/life-dashboard/deploy/.env) and is git-ignored.
# Fill values there; never commit, log, or paste them anywhere.

# Timezone for containers (Q2 — confirm before WP24)
TZ=

# Cloudflare tunnel token (WP11) — pasted by B. directly on the NAS, never
# via chat. Routes the domain to any origin: a leak requires rotation.
TUNNEL_TOKEN=

# WP24 Open-Meteo needs no key. Later connectors add their variables here:
# GCAL_ICS_URL_YOU=      (WP25, secret ICS URL)
# GCAL_ICS_URL_HER=      (WP25, secret ICS URL)
# MACROMATES_SUPABASE_URL=       (WP27)
# MACROMATES_SERVICE_KEY=        (WP27, pending Q17 sign-off)
# HOME_ASSISTANT_URL=            (WP28)
# HOME_ASSISTANT_TOKEN=          (WP28)
# JELLYFIN_URL=                  (WP29)
# JELLYFIN_API_KEY=              (WP29)
# NAS_STATS_ROOT=                (WP30)
