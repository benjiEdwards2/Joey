# Template for deploy/powerctl.env (JY-274) - the real file lives ONLY on the NAS, chmod 600, git-ignored.
# Read by the powerctl service only (deploy/docker-compose.yml, profile `power`). Never commit, log or paste the value.
# The hub carries the same value as POWER_TOKEN in deploy/hub.env.
POWERCTL_TOKEN=
# Optional overrides (defaults in powerctl/Dockerfile):
# STOP_CMD=docker compose -p media-server stop -t 45
# SHUTDOWN_CMD=nsenter -t 1 -m -u -i -n -p -- poweroff
# GRACE_S=3
