## Joey TV WP-A3 (2026-10-18) — adapted from SWAG 5.8.0-ls490's fail2ban/jail.local (Version 2022/08/20).
## Bind-mounted read-only at /config/fail2ban/jail.local; SWAG's init copies it to /etc/fail2ban at every start.
## Changes from the default: the jellyfin-auth jail (E7); nginx-unauthorized switched OFF — it bans on ANY 401, and
## Jellyfin answers every request from a TV holding a stale token with 401, so it would ban friends' households.
## Bans need the REAL client IP in SWAG's access log: host network mode has it natively (WP-A4, Q44 = a), and the
## iptables bans land in the host netns (live check WP-A4 step 11, WP-A5 G5).

[DEFAULT]
# Prevents banning the LAN and loopback (deploy.sh's smoke curl): the same set the geo gate treats as local. No client
# arrives as a Docker bridge address in host mode, so 172.16/12 is not ignored.
ignoreip = 10.0.0.0/8
           192.168.0.0/16
           127.0.0.1/32

# Changes the default ban action from "iptables-multiport", which causes issues on some platforms, to "iptables-allports".
# DROP, not the stock REJECT: the ADM 6.6 kernel lacks the REJECT extension for iptables-nft ("revision 0 not supported"),
# so REJECT bans are recorded but never enforced; DROP is a native nft verdict (Joey TV WP-A4 step 11, 2026-10-19).
banaction = iptables-allports[blocktype=DROP]

# "bantime" is the number of seconds that a host is banned.
bantime  = 600

# A host is banned if it has generated "maxretry" during the last "findtime"
# seconds.
findtime  = 600

# "maxretry" is the number of failures before a host get banned.
maxretry = 5


[ssh]
enabled = false

[nginx-http-auth]
enabled  = true
filter   = nginx-http-auth
port     = http,https
logpath  = /config/log/nginx/error.log

[nginx-badbots]
enabled  = true
port     = http,https
filter   = nginx-badbots
logpath  = /config/log/nginx/access.log
maxretry = 2

[nginx-botsearch]
enabled  = true
port     = http,https
filter   = nginx-botsearch
logpath  = /config/log/nginx/access.log

[nginx-deny]
enabled  = true
port     = http,https
filter   = nginx-deny
logpath  = /config/log/nginx/error.log

[nginx-unauthorized]
enabled  = false
port     = http,https
filter   = nginx-unauthorized
logpath  = /config/log/nginx/access.log

# E7: failed Jellyfin sign-ins (password and Quick Connect) — 5 in 10 minutes bans the address for an hour
[jellyfin-auth]
enabled  = true
port     = https
filter   = jellyfin-auth
logpath  = /config/log/nginx/access.log
maxretry = 5
findtime = 600
bantime  = 3600
