<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE arrives with Media3 ExoPlayer (JY-057: its bandwidth meter); a normal permission, no prompt. -->
    <!-- REQUEST_INSTALL_PACKAGES is added by the sideload flavor only (src/sideload/AndroidManifest.xml). -->

    <!-- One APK for Android TV, Google TV and Fire TV: neither leanback nor a touchscreen is required. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: the Jellyfin app, both stores, and the external intents the shell fires. -->
    <queries>
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="com.android.vending" />
        <package android:name="com.amazon.venezia" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amzn" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.youtube.com" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JoeyTV">

        <activity
            android:name=".MainActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- JY-057: Joey's own player (Media3 ExoPlayer, look A). Started only by MainActivity with an item id. -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@style/Theme.JoeyTV.Player" />
    </application>
</manifest>
