<?xml version="1.0" encoding="utf-8"?>
<!-- JY-307 P5: the player's icon buttons, 84 px round. The focused one (isActivated, from PlayerUi) turns white and widens
     into a pill carrying its label (PlayerActivity.renderButton). Android focus is not used inside the player. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <solid android:color="@color/joey_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <solid android:color="@color/joey_line" />
        </shape>
    </item>
</selector>
