<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView is added at index 0 in code (MainActivity.createWebView) so it can be recreated after a renderer crash.
     Native screens stack inside `overlay`, above it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/joey_bg">

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
