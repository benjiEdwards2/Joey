<?xml version="1.0" encoding="utf-8"?>
<!-- JY-057 Joey TV player; JY-307 phase 5 (option B) overlay at the P2b scale: the picture full-bleed; one left-aligned
     block over a bottom gradient (~45 % of the height): the title block (eyebrow, title, line), the chapter + time line,
     the thin bar, then a row of icon-only round buttons (the focused one shows its label). The Audio & subtitles pop-up
     sits above the row; the up-next card bottom right. Visibility and the focus ring come from PlayerUi's state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/joey_black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <TextView
        android:id="@+id/player_loading"
        style="@style/JoeyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/player_starting" />

    <!-- the bottom block: title block, time line, bar (row 1), buttons (row 2) -->
    <LinearLayout
        android:id="@+id/player_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:minHeight="@dimen/player_scrim_h"
        android:background="@drawable/player_scrim_bottom"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/player_mx"
        android:paddingEnd="@dimen/player_mx"
        android:paddingBottom="@dimen/player_my">

        <TextView
            android:id="@+id/player_eyebrow"
            style="@style/JoeyPlayerEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/player_title"
            style="@style/JoeyPlayerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/player_title_max"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/player_line"
            style="@style/JoeyPlayerLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/player_title_max"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_chapter"
                style="@style/JoeyPlayerLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/player_time"
                style="@style/JoeyPlayerLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum" />

            <!-- Q3 default: the diagnostic words only while paused, muted, at the end of the time line -->
            <TextView
                android:id="@+id/player_meta"
                style="@style/JoeyPlayerMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <net.joeyhome.media.PlayerBar
            android:id="@+id/player_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/player_bar_row"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_btn_play"
                style="@style/JoeyPlayerButton"
                android:contentDescription="@string/player_pause"
                android:drawableStart="@drawable/ic_player_pause" />

            <TextView
                android:id="@+id/player_btn_back"
                style="@style/JoeyPlayerButton"
                android:contentDescription="@string/player_back_10"
                android:drawableStart="@drawable/ic_player_back" />

            <TextView
                android:id="@+id/player_btn_forward"
                style="@style/JoeyPlayerButton"
                android:contentDescription="@string/player_forward_30"
                android:drawableStart="@drawable/ic_player_forward" />

            <TextView
                android:id="@+id/player_btn_tracks"
                style="@style/JoeyPlayerButton"
                android:contentDescription="@string/player_tracks"
                android:drawableStart="@drawable/ic_player_tracks" />

            <TextView
                android:id="@+id/player_btn_next"
                style="@style/JoeyPlayerButton"
                android:contentDescription="@string/player_next"
                android:drawableStart="@drawable/ic_player_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- the Audio & subtitles pop-up, above the button row: two 540 px columns, 84 px rows (max 6) -->
    <LinearLayout
        android:id="@+id/player_popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/player_mx"
        android:layout_marginBottom="74dp"
        android:background="@drawable/player_card"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="@dimen/player_popup_col"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/JoeyPlayerEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/player_audio" />

            <ScrollView
                android:id="@+id/player_audio_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/player_audio_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/player_popup_col"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/JoeyPlayerEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/player_subtitles" />

            <ScrollView
                android:id="@+id/player_subs_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/player_subs_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- the up-next card, bottom right: "Up next", the 400 x 225 px 16:9 tile with the next episode's still (a plain
         tile until it loads, or if it fails), the label, the runtime or countdown, then Play now / Watch credits -->
    <LinearLayout
        android:id="@+id/player_upnext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/player_mx"
        android:layout_marginBottom="@dimen/player_my"
        android:background="@drawable/player_card"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            style="@style/JoeyPlayerEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/player_up_next" />

        <ImageView
            android:id="@+id/player_upnext_still"
            android:layout_width="@dimen/player_upnext_tile"
            android:layout_height="@dimen/player_upnext_tile_h"
            android:background="@drawable/player_tile"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/player_upnext_label"
            style="@style/JoeyPlayerLine"
            android:layout_width="@dimen/player_upnext_tile"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/joey_text_1"
            android:textSize="@dimen/player_label"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/player_upnext_meta"
            style="@style/JoeyPlayerMethod"
            android:layout_width="@dimen/player_upnext_tile"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- the chips side by side under the tile -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_upnext_play"
                style="@style/JoeyPlayerChip"
                android:layout_marginEnd="4dp"
                android:text="@string/player_play_now" />

            <TextView
                android:id="@+id/player_upnext_credits"
                style="@style/JoeyPlayerChip"
                android:text="@string/player_watch_credits" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
