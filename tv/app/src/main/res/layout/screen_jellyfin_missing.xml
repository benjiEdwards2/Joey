<?xml version="1.0" encoding="utf-8"?>
<!-- Jellyfin app missing (DECISIONS E, mockup screen 8): explainer + store button. Back closes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/JoeyScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        style="@style/JoeyIcon"
        android:src="@drawable/ic_tv_question" />

    <TextView
        style="@style/JoeyText.H1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nojf_title" />

    <TextView
        style="@style/JoeyText"
        android:layout_width="@dimen/joey_dialog_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:text="@string/nojf_body" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nojf_get"
            style="@style/JoeyButton.Primary"
            android:text="@string/nojf_get" />

        <Button
            android:id="@+id/nojf_back"
            style="@style/JoeyButton.Secondary"
            android:text="@string/nojf_back" />
    </LinearLayout>

    <TextView
        android:id="@+id/nojf_store"
        style="@style/JoeyText.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/nojf_server"
        style="@style/JoeyText.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
