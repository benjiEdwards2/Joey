<?xml version="1.0" encoding="utf-8"?>
<!-- Plain explainer card (WP-B8: unknown-sources steps where the Settings screen cannot be opened, e.g. Fire OS).
     Same card as the update prompt; OK and Back close it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/joey_dim">

    <LinearLayout
        android:layout_width="@dimen/joey_dialog_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="36dp">

        <ImageView
            style="@style/JoeyIcon"
            android:src="@drawable/ic_update" />

        <TextView
            android:id="@+id/message_title"
            style="@style/JoeyText.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/message_body"
            style="@style/JoeyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/message_ok"
            style="@style/JoeyButton.Primary"
            android:text="@string/message_ok" />
    </LinearLayout>
</FrameLayout>
