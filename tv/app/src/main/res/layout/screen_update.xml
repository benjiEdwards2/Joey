<?xml version="1.0" encoding="utf-8"?>
<!-- Update prompt (DECISIONS F, mockup screens 6/7). Optional: "Update now" focused, Later/Back dismiss.
     Forced: no Later, Back exits. The logic that shows it is WP-B8 step 7. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/joey_dim">

    <LinearLayout
        android:layout_width="@dimen/joey_dialog_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="36dp">

        <ImageView
            style="@style/JoeyIcon"
            android:src="@drawable/ic_update" />

        <TextView
            android:id="@+id/update_title"
            style="@style/JoeyText.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/update_body"
            style="@style/JoeyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/update_notes"
            style="@style/JoeyText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/update_now"
                style="@style/JoeyButton.Primary"
                android:text="@string/update_now" />

            <Button
                android:id="@+id/update_later"
                style="@style/JoeyButton.Secondary"
                android:text="@string/update_later" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
