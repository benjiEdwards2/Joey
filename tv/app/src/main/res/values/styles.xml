<?xml version="1.0" encoding="utf-8"?>
<!-- Native-screen look (WP-M mockup, not yet signed off): change tokens in colors.xml / dimens.xml, shapes in drawable/. -->
<resources>
    <style name="Theme.JoeyTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/joey_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">@color/joey_primary</item>
        <item name="android:textColorPrimary">@color/joey_text_1</item>
    </style>

    <style name="JoeyScreen">
        <item name="android:background">@color/joey_bg</item>
        <item name="android:paddingStart">@dimen/joey_overscan_x</item>
        <item name="android:paddingEnd">@dimen/joey_overscan_x</item>
        <item name="android:paddingTop">@dimen/joey_overscan_y</item>
        <item name="android:paddingBottom">@dimen/joey_overscan_y</item>
    </style>

    <style name="JoeyIcon">
        <item name="android:layout_width">@dimen/joey_icon</item>
        <item name="android:layout_height">@dimen/joey_icon</item>
        <item name="android:layout_marginBottom">@dimen/joey_gap</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="JoeyText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/joey_text_2</item>
        <item name="android:textSize">@dimen/joey_body</item>
    </style>

    <style name="JoeyText.H1">
        <item name="android:textColor">@color/joey_text_1</item>
        <item name="android:textSize">@dimen/joey_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="JoeyText.Meta">
        <item name="android:textColor">@color/joey_text_4</item>
        <item name="android:textSize">@dimen/joey_meta</item>
    </style>

    <style name="JoeyButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/joey_button_height</item>
        <item name="android:minWidth">160dp</item>
        <item name="android:paddingStart">36dp</item>
        <item name="android:paddingEnd">36dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/joey_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_marginEnd">@dimen/joey_gap</item>
    </style>

    <style name="JoeyButton.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/joey_text_1</item>
    </style>

    <style name="JoeyButton.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/joey_text_2</item>
    </style>

    <!-- JY-057 player: an up-next chip or a pop-up row. The ring comes from isActivated (PlayerUi), not Android focus.
         JY-307 P5: 72 px chips, 30 px labels (tv-fs-label). -->
    <style name="JoeyPlayerChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/player_chip_height</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/player_chip</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/player_label</item>
        <item name="android:textColor">@color/joey_text_1</item>
        <item name="android:maxLines">1</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- JY-307 P5: pop-up rows, 84 px, 30 px text -->
    <style name="JoeyPlayerRow" parent="JoeyPlayerChip">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/player_row</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- JY-307 P5: an icon-only round button (84 px, 40 px icon); the focused one shows its 30 px label (render code) -->
    <style name="JoeyPlayerButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/player_button_height</item>
        <item name="android:minWidth">@dimen/player_button_height</item>
        <item name="android:paddingStart">@dimen/player_button_pad</item>
        <item name="android:paddingEnd">@dimen/player_button_pad</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/player_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/player_label</item>
        <item name="android:textColor">@color/player_button_ink</item>
        <item name="android:drawableTint">@color/player_button_ink</item>
        <item name="android:maxLines">1</item>
        <item name="android:focusable">false</item>
        <item name="android:layout_marginEnd">@dimen/player_button_gap</item>
    </style>

    <!-- JY-307 P5: the title block, bottom left: eyebrow 27 px amber caps, title 48 px, line 27 px -->
    <style name="JoeyPlayerEyebrow">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/player_eyebrow</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/joey_amber</item>
    </style>

    <style name="JoeyPlayerTitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/player_title</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/joey_text_1</item>
    </style>

    <!-- the line under the title, the time line and the chapter: 27 px -->
    <style name="JoeyPlayerLine">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/player_method</item>
        <item name="android:textColor">@color/joey_text_2</item>
    </style>

    <!-- the diagnostic words (method, first frame) and the pop-up / card captions: 27 px muted -->
    <style name="JoeyPlayerMethod">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/player_method</item>
        <item name="android:textColor">@color/joey_text_4</item>
    </style>

    <style name="Theme.JoeyTV.Player" parent="Theme.JoeyTV">
        <item name="android:windowBackground">@color/joey_black</item>
    </style>

    <style name="JoeyField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/joey_text_1</item>
        <item name="android:textColorHint">@color/joey_text_4</item>
        <item name="android:textSize">@dimen/joey_meta</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:inputType">textUri</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:layout_marginBottom">@dimen/joey_gap</item>
    </style>
</resources>
